# Dial A Service backend settings.
# Copy to .env (never commit .env) and fill in real values.
# Every value here is a dummy. Variables marked "(from Mx)" aren't read yet.

# --- Django --------------------------------------------------------------------
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# true only on your machine; always false on staging and production.
DJANGO_DEBUG=true
# Key for hashing SMS codes. Optional locally (falls back to DJANGO_SECRET_KEY);
# set its own random value in staging and production.
OTP_HASH_KEY=
# Which service this process is: api (business hosts) or platform_admin.
DJANGO_SERVICE=api
# Comma-separated. Local settings add .localhost automatically.
# Staging/production: .dialaservice.co.ke
DJANGO_ALLOWED_HOSTS=
# Seconds to keep database connections open (0 = close after each request).
DJANGO_CONN_MAX_AGE=0
# Log level: DEBUG, INFO, WARNING or ERROR. Logs are JSON lines with phones masked.
DJANGO_LOG_LEVEL=INFO
# The refresh-token cookie is Secure unless this is false (local http only).
REFRESH_COOKIE_SECURE=false
# Set to 0 in the process environment (not in this file) to ignore .env entirely.
# Tests use this to start Django with a clean environment.
# DJANGO_READ_DOT_ENV=1

# --- Platform --------------------------------------------------------------------
PLATFORM_ROOT_DOMAIN=dialaservice.co.ke
PLATFORM_ADMIN_HOST=admin.dialaservice.co.ke

# --- Database (Neon Postgres 16, ADR-0001 section 5) --------------------------------
# App role dial_app, subject to row-level security. Use Neon's POOLED host (-pooler).
DATABASE_URL=postgres://dial_app:dummy-password@ep-example-pooler.eu-central-1.aws.neon.tech/dialaservice?sslmode=require
# Owner role dial_owner, used only by scripts/migrate.ps1 and the test setup. Use the DIRECT host.
DATABASE_MIGRATION_URL=postgres://dial_owner:dummy-password@ep-example.eu-central-1.aws.neon.tech/dialaservice?sslmode=require
# Platform role dial_platform (BYPASSRLS). Only the platform-admin service uses it,
# as its DATABASE_URL. scripts/db/setup_roles.py writes this line for you.
PLATFORM_DATABASE_URL=postgres://dial_platform:dummy-password@ep-example.eu-central-1.aws.neon.tech/dialaservice?sslmode=require

# --- Cache and queue ---------------------------------------------------------------
# Redis for Celery and the cache (rediss:// where TLS is required).
# Leave empty locally to run tasks eagerly after commit; required in production.
REDIS_URL=

# --- Secrets for later milestones ----------------------------------------------------
# (from M4) Encrypts each business's Daraja secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=dummy-fernet-key

# --- File storage (Cloudflare R2, from M1 task T08) -----------------------------------
STORAGE_ENDPOINT=https://example-account-id.r2.cloudflarestorage.com
STORAGE_BUCKET=dial-a-service-dev
STORAGE_ACCESS_KEY=dummy-access-key
STORAGE_SECRET_KEY=dummy-secret-key

# --- M-Pesa (from M4 and M6; sandbox only until launch) --------------------------------
MPESA_ENV=sandbox
PLATFORM_MPESA_CONSUMER_KEY=dummy
PLATFORM_MPESA_CONSUMER_SECRET=dummy
PLATFORM_MPESA_SHORTCODE=000000
PLATFORM_MPESA_PASSKEY=dummy
PLATFORM_MPESA_CALLBACK_TOKEN=dummy

# --- SMS gateway (from M4; M1 uses the console backend) ---------------------------------
# Which backend sends SMS. Development prints them to the terminal.
SMS_BACKEND=apps.notifications.backends.ConsoleSmsBackend
SMS_API_KEY=dummy
SMS_USERNAME=dummy
SMS_SENDER_ID=DIALASERVICE

# --- Email (from M6) -------------------------------------------------------------------
RESEND_API_KEY=dummy
DEFAULT_FROM_EMAIL=no-reply@dialaservice.co.ke

# --- Error tracking ---------------------------------------------------------------------
# Leave empty locally.
SENTRY_DSN=
