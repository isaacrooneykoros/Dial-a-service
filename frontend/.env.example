# Dial A Service frontend settings (Vite reads VITE_* at build time).
# Copy to .env.local for local overrides; never commit real values.

# Where the Vite dev server sends /api calls (the Django dev server).
VITE_API_TARGET=http://127.0.0.1:8000

# This build's version, compared with /api/v1/app/version for X-02 (set by CI).
VITE_APP_VERSION=0.1.0
